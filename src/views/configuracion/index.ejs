<p class="config-crumb">Configuración · Telegram</p>
<div class="page-heading">
  <h1>Telegram</h1>
  <button type="button" class="btn-nuevo is-mark" onclick="document.getElementById('capture-telegram').showModal()" aria-label="Vincular chat">
    <i class="fa-solid fa-plus" aria-hidden="true"></i>
    <i class="fa-brands fa-telegram" aria-hidden="true"></i>
  </button>
</div>

<% if (success) { %>
  <p class="success-msg" role="status">
    <% if (success === 'codigo') { %>Código generado. Mandáselo al bot para vincular el chat.<% } %>
    <% if (success === 'desvinculado') { %>Chat desconectado.<% } %>
  </p>
<% } %>
<% if (error) { %>
  <p class="error-msg" role="alert"><%= error %></p>
<% } %>

<section class="page-pane cfg-layout" id="telegram">
  <article class="panel cfg-list-panel">
    <h2>Listado de chats</h2>
    <% if (telegram.activos.length > 0) { %>
      <ul class="cfg-cards">
        <% telegram.activos.forEach(function(v) { %>
          <li class="cfg-card">
            <div class="cfg-card-head">
              <h3 class="cfg-card-title"><i class="fa-solid fa-user" aria-hidden="true"></i> <%= v.alias %></h3>
            </div>
            <p class="cfg-card-meta">
              <span>Vinculado <%= new Date(v.vinculadoEn).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
            </p>
            <div class="cfg-card-foot">
              <div class="dt-actions">
                <form method="POST" action="/configuracion/telegram/<%= v.id %>/desvincular">
                  <button type="submit" class="dt-ico-btn is-del" title="Desconectar" aria-label="Desconectar">
                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                  </button>
                </form>
              </div>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="hint">Todavía no hay chats vinculados. <a href="#form" onclick="document.getElementById('capture-telegram').showModal(); return false;">Generá un código</a>.</p>
    <% } %>
  </article>
</section>

<dialog class="capture-sheet" id="capture-telegram">
  <div class="capture-sheet-inner">
    <div class="capture-sheet-header">
      <h2>Vincular Telegram</h2>
      <button type="button" class="secondary outline btn-sm capture-close" onclick="this.closest('dialog').close()" aria-label="Cerrar">✕</button>
    </div>
    <form class="cat-form" method="POST" action="/configuracion/telegram/codigo">
      <div class="cfg-form-fields">
        <% if (!telegram.configurado) { %>
          <p class="info-msg">
            Falta configurar <code>TELEGRAM_BOT_TOKEN</code> en el archivo <code>.env</code> y levantar el proceso del bot.
          </p>
        <% } else { %>
          <p class="hint">El código sirve una sola vez y vence a los <%= ttlMinutos %> minutos.</p>
        <% } %>
        <% if (telegram.pendiente) { %>
          <div class="tg-codigo">
            <span class="tg-codigo-label">Tu código de vinculación</span>
            <strong class="tg-codigo-value"><%= telegram.pendiente.codigo %></strong>
            <span class="tg-codigo-hint">
              Vence en <%= telegram.pendiente.minutosRestantes %> minuto<%= telegram.pendiente.minutosRestantes === 1 ? '' : 's' %>.
              <% if (telegram.botUrl) { %>
                <a href="<%= telegram.botUrl %>" target="_blank" rel="noopener noreferrer">Abrí el chat</a>: el código viaja en el enlace.
              <% } else { %>
                Abrí el chat con el bot y mandá <code>/vincular <%= telegram.pendiente.codigo %></code>
              <% } %>
            </span>
          </div>
        <% } %>
      </div>
      <div class="form-actions cat-form-actions">
        <button type="submit" class="btn btn-accent cat-form-ico-btn" title="<%= telegram.pendiente ? 'Generar otro código' : 'Generar código de vinculación' %>" aria-label="<%= telegram.pendiente ? 'Generar otro código' : 'Generar código de vinculación' %>" <%= telegram.configurado ? '' : 'disabled' %>>
          <i class="fa-solid fa-key" aria-hidden="true"></i>
        </button>
      </div>
    </form>
  </div>
</dialog>
<%- include('../partials/_capture-boot', { dialogId: 'capture-telegram', open: Boolean(telegram.pendiente) || success === 'codigo' || Boolean(error) }) %>
