<h1><%= cuenta.nombre %></h1>
<p class="hint">Saldo actual: <strong><%= cuenta.divisa.simbolo %> <%= Number(cuenta.saldoActual).toLocaleString('es-AR') %></strong></p>

<% if (success) { %>
  <p class="success-msg" role="status">
    <% if (success === 'movimiento') { %>Movimiento registrado.<% } %>
    <% if (success === 'ajuste') { %>Saldo ajustado.<% } %>
  </p>
<% } %>
<% if (errors.general) { %>
  <p class="error-msg" role="alert"><%= errors.general %></p>
<% } %>

<section class="two-col">
  <article class="panel">
    <h2>Registrar movimiento</h2>
    <form method="post" action="/cuentas/<%= cuenta.id %>/movimientos">
      <label>
        Tipo
        <select name="tipo" required>
          <option value="INGRESO" <%= values.tipo === 'INGRESO' ? 'selected' : '' %>>Ingreso</option>
          <option value="EGRESO" <%= values.tipo === 'EGRESO' ? 'selected' : '' %>>Egreso</option>
        </select>
      </label>
      <label>
        Monto
        <input type="number" name="monto" step="0.01" min="0.01" value="<%= values.monto || '' %>" required>
        <% if (errors.monto) { %><small class="error-msg"><%= errors.monto %></small><% } %>
      </label>
      <label>
        Fecha
        <input type="date" name="fecha" value="<%= values.fecha || '' %>" required>
      </label>
      <label>
        Descripción
        <input type="text" name="descripcion" value="<%= values.descripcion || '' %>" placeholder="Opcional">
      </label>
      <label>
        Categoría
        <select name="categoriaId">
          <option value="">Sin categoría</option>
          <% categorias.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= values.categoriaId === c.id ? 'selected' : '' %>><%= c.nombre %></option>
          <% }); %>
        </select>
      </label>
      <button type="submit">Registrar</button>
    </form>

    <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid var(--border);">

    <h2>Ajustar saldo</h2>
    <form method="post" action="/cuentas/<%= cuenta.id %>/ajustar">
      <label>
        Saldo real en cuenta
        <input type="number" name="saldoReal" step="0.01" value="<%= Number(cuenta.saldoActual) %>" required>
      </label>
      <button type="submit" class="secondary outline">Ajustar</button>
    </form>
  </article>

  <article class="panel">
    <h2>Historial</h2>
    <% if (movimientos.length === 0) { %>
      <p class="hint">Sin movimientos todavía.</p>
    <% } else { %>
      <ul class="expense-list">
        <% movimientos.forEach(function(m) { %>
          <li>
            <span class="expense-meta">
              <span class="expense-name"><%= m.descripcion || m.tipo.toLowerCase() %></span>
              <span class="expense-tag"><%= new Date(m.fecha).toLocaleDateString('es-AR') %> · <%= m.tipo.toLowerCase() %></span>
            </span>
            <span class="expense-amount <%= m.tipo === 'INGRESO' ? 'amount positive' : m.tipo === 'EGRESO' ? 'amount negative' : '' %>">
              <%= m.tipo === 'EGRESO' ? '−' : m.tipo === 'INGRESO' ? '+' : '±' %>
              <%= m.divisa.simbolo %> <%= Number(m.monto).toLocaleString('es-AR') %>
            </span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </article>
</section>

<a href="/cuentas" class="page-back">← Cuentas</a>
