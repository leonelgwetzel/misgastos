<%
  var path = typeof currentPath !== 'undefined' ? currentPath : '/';
  var isInicio = path === '/';
  var isMov = path.startsWith('/movimientos') || path.startsWith('/ingresos') || path.startsWith('/gastos');
  var isConfig = path.startsWith('/configuracion') || path.startsWith('/cuentas') || path.startsWith('/tarjetas') || path.startsWith('/divisas') || path.startsWith('/categorias') || path.startsWith('/usuarios');
%>
<nav class="mobile-dock" aria-label="Navegación móvil">
  <a href="/" class="<%= isInicio ? 'is-active' : '' %>" aria-label="Dashboard"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i></a>
  <a href="/movimientos" class="<%= isMov ? 'is-active' : '' %>" aria-label="Movimientos"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i></a>
  <a href="/configuracion" class="<%= isConfig ? 'is-active' : '' %>" aria-label="Configuración"><i class="fa-solid fa-gear" aria-hidden="true"></i></a>
</nav>
