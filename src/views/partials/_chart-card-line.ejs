<%
  const puntos = (typeof serie !== 'undefined' && serie) ? serie : [];
  const W = 400;
  const H = 210;
  const padX = 36;
  const padTop = 22;
  const padBottom = 36;
  const chartW = W - padX * 2;
  const chartH = H - padTop - padBottom;
  const maxG = puntos.length
    ? Math.max.apply(null, puntos.map(function(p) { return Number(p.gastos) || 0; }).concat([1]))
    : 1;
  const coords = puntos.map(function(p, i) {
    const x = padX + (puntos.length <= 1 ? chartW / 2 : (i / (puntos.length - 1)) * chartW);
    const y = padTop + chartH - ((Number(p.gastos) || 0) / maxG) * chartH;
    const name = String(p.label || '');
    return Object.assign({}, p, {
      x: x,
      y: y,
      corto: name.length > 8 ? name.slice(0, 7) + '…' : name,
    });
  });
  const linePath = coords.map(function(c, i) {
    return (i === 0 ? 'M' : 'L') + c.x.toFixed(1) + ',' + c.y.toFixed(1);
  }).join(' ');
  const baseY = padTop + chartH;
  const areaPath = coords.length
    ? linePath
      + ' L' + coords[coords.length - 1].x.toFixed(1) + ',' + baseY.toFixed(1)
      + ' L' + coords[0].x.toFixed(1) + ',' + baseY.toFixed(1)
      + ' Z'
    : '';
%>
<% if (coords.length > 0) { %>
  <div class="evo-chart card-line" role="img" aria-label="<%= typeof ariaLabel !== 'undefined' ? ariaLabel : 'Compromisos por tarjeta' %>">
    <svg class="evo-chart-svg" viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="card-line-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.28"/>
          <stop offset="100%" stop-color="currentColor" stop-opacity="0.02"/>
        </linearGradient>
      </defs>
      <% for (var g = 0; g <= 2; g++) {
        const gy = padTop + (chartH / 2) * g;
      %>
        <line class="evo-grid-line" x1="<%= padX %>" y1="<%= gy %>" x2="<%= W - padX %>" y2="<%= gy %>"/>
      <% } %>
      <% if (coords.length > 1) { %>
        <path class="evo-area" d="<%= areaPath %>" fill="url(#card-line-fill)"/>
        <path class="evo-line" d="<%= linePath %>" fill="none"/>
      <% } %>
      <% coords.forEach(function(c) { %>
        <g class="evo-point">
          <circle cx="<%= c.x.toFixed(1) %>" cy="<%= c.y.toFixed(1) %>" r="4.5" style="fill: <%= c.color || 'currentColor' %>; stroke: var(--bg-surface)"/>
          <text class="evo-point-label" x="<%= c.x.toFixed(1) %>" y="<%= H - 8 %>" text-anchor="middle"><%= c.corto %></text>
        </g>
      <% }); %>
    </svg>
    <ul class="evo-legend card-line-legend">
      <% coords.forEach(function(c) { %>
        <li class="evo-legend-item">
          <span class="card-line-swatch" style="background: <%= c.color || 'currentColor' %>;"></span>
          <span class="evo-legend-label"><%= c.label %></span>
          <span class="evo-legend-value amount"><%= c.formateado %></span>
        </li>
      <% }); %>
    </ul>
  </div>
<% } else { %>
  <p class="hint"><%= typeof emptyHint !== 'undefined' ? emptyHint : 'Sin compromisos este mes.' %></p>
<% } %>
