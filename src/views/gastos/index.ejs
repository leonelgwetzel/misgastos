<div class="page-heading">
  <h1>Gastos</h1>
  <button type="button" class="btn-nuevo" id="btn-nuevo-gasto" onclick="document.getElementById('capture-gasto').showModal()">
    <span class="btn-nuevo-ico"><i class="fa-solid fa-plus" aria-hidden="true"></i></span>
    <span>Nuevo</span>
  </button>
</div>

<% if (success) { %>
  <p class="success-msg toast-success" role="status">
    <% if (success === 'creado') { %>Gasto registrado.<% } %>
    <% if (success === 'actualizado') { %>Gasto actualizado.<% } %>
    <% if (success === 'eliminado') { %>Gasto eliminado.<% } %>
  </p>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <p class="error-msg" role="alert"><%= error %></p>
<% } %>
<% if (errors.general) { %>
  <p class="error-msg" role="alert"><%= errors.general %></p>
<% } %>

<section class="data-page panel page-pane">
  <div class="data-list-header dt-toolbar-row">
    <div>
      <h2>Todos los gastos</h2>
      <p class="hint data-list-count">
        <% if (pagination.total === 0) { %>Sin resultados<% } else { %>
          <%= pagination.total %> gasto<%= pagination.total === 1 ? '' : 's' %>
          <% if (filtro.q) { %> · filtro “<%= filtro.q %>”<% } %>
        <% } %>
      </p>
    </div>
    <form class="data-page-toolbar" method="get" action="/gastos" role="search">
      <input type="search" name="q" value="<%= filtro.q || '' %>" placeholder="Buscar…" aria-label="Buscar gasto">
      <button type="submit" class="secondary outline btn-sm">Buscar</button>
      <% if (filtro.q) { %><a href="/gastos" class="secondary outline btn-sm">Limpiar</a><% } %>
    </form>
  </div>

  <% if (gastos.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-receipt empty-ico" aria-hidden="true"></i>
      <% if (filtro.q) { %>
        <p>No hay gastos que coincidan con “<%= filtro.q %>”.</p>
      <% } else { %>
        <p>Sin gastos registrados.</p>
        <p class="empty-actions">
          <a href="#nuevo" onclick="document.getElementById('capture-gasto').showModal(); return false;">Registrar el primero</a>
        </p>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-wrap dt-wrap">
      <table class="dt">
        <thead>
          <tr>
            <th>Descripción</th>
            <th>Fecha</th>
            <th>Medio</th>
            <th>Detalle</th>
            <th class="col-num">Monto</th>
            <th class="col-actions">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% gastos.forEach(function(g) { %>
            <% const deleteQs = []; if (pagination.page > 1) deleteQs.push('page=' + pagination.page); if (filtro.q) deleteQs.push('q=' + encodeURIComponent(filtro.q)); const deleteAction = '/gastos/' + g.id + '/eliminar' + (deleteQs.length ? '?' + deleteQs.join('&') : ''); %>
            <tr>
              <td class="col-desc" data-label="Descripción"><strong><%= g.descripcion %></strong><% if (g.cantidadCuotas > 1) { %> <span class="hint"><%= g.cantidadCuotas %> cuotas</span><% } %></td>
              <td data-label="Fecha"><%= new Date(g.fechaCompra).toLocaleDateString('es-AR') %></td>
              <td data-label="Medio"><%= g.medioPago.toLowerCase() %></td>
              <td data-label="Detalle"><% if (g.tarjeta) { %><%= g.tarjeta.alias %><% } else if (g.cuenta) { %><%= g.cuenta.nombre %><% } else { %>—<% } %></td>
              <td class="col-num" data-label="Monto"><%= g.divisa.simbolo %> <%= Number(g.montoOriginal).toLocaleString('es-AR') %></td>
              <td class="col-actions" data-label="Acciones">
                <div class="dt-actions">
                  <a href="/gastos?edit=<%= g.id %><%= filtro.q ? '&q=' + encodeURIComponent(filtro.q) : '' %><%= pagination.page > 1 ? '&page=' + pagination.page : '' %>#nuevo" class="dt-ico-btn is-edit" title="Editar" aria-label="Editar">
                    <i class="fa-solid fa-pencil" aria-hidden="true"></i>
                  </a>
                  <form method="post" action="<%= deleteAction %>"
                        onsubmit="return confirm('<%= g.medioPago === 'TARJETA' ? (g.gastoFijoId ? '¿Borrar este gasto y todas sus cuotas? Si es de un gasto fijo, puede regenerarse al entrar al inicio.' : '¿Borrar este gasto y todas sus cuotas?') : '¿Borrar este gasto?' %>')">
                    <button type="submit" class="dt-ico-btn is-del" title="Eliminar" aria-label="Eliminar">
                      <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (pagination.totalPages > 1) { %>
      <nav class="gastos-pagination" aria-label="Paginación de gastos">
        <% if (pagination.prevUrl) { %>
          <a href="<%= pagination.prevUrl %>" class="secondary outline btn-sm">‹ Anterior</a>
        <% } else { %>
          <span class="btn-sm pagination-disabled" aria-hidden="true">‹ Anterior</span>
        <% } %>
        <span class="pagination-info">Página <%= pagination.page %> de <%= pagination.totalPages %></span>
        <% if (pagination.nextUrl) { %>
          <a href="<%= pagination.nextUrl %>" class="secondary outline btn-sm">Siguiente ›</a>
        <% } else { %>
          <span class="btn-sm pagination-disabled" aria-hidden="true">Siguiente ›</span>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</section>

<dialog class="capture-sheet" id="capture-gasto">
  <div class="capture-sheet-inner">
    <div class="capture-sheet-header">
      <h2><%= editing ? 'Editar gasto' : 'Nuevo gasto' %></h2>
      <button type="button" class="secondary outline btn-sm capture-close" onclick="this.closest('dialog').close()" aria-label="Cerrar">✕</button>
    </div>
    <%- include('../partials/form-gasto') %>
  </div>
</dialog>

<script>
  (function () {
    const dialog = document.getElementById('capture-gasto');
    const shouldOpen = location.hash === '#nuevo' || <%= editing ? 'true' : 'false' %> || <%= Object.keys(errors || {}).length ? 'true' : 'false' %>;
    if (dialog && shouldOpen) dialog.showModal();
    window.addEventListener('hashchange', function () {
      if (location.hash === '#nuevo' && dialog) dialog.showModal();
    });
    const medio = document.getElementById('medioPago');
    if (!medio) return;
    const tarjeta = document.getElementById('campos-tarjeta');
    const efectivo = document.getElementById('campos-efectivo');
    function toggle() {
      const esTarjeta = medio.value === 'TARJETA';
      tarjeta.hidden = !esTarjeta;
      efectivo.hidden = esTarjeta;
      tarjeta.querySelectorAll('select, input').forEach(function (el) { el.disabled = !esTarjeta; });
      efectivo.querySelectorAll('select, input').forEach(function (el) { el.disabled = esTarjeta; });
    }
    medio.addEventListener('change', toggle);
    toggle();
  })();
</script>
